# Bayrakstar — Cloudflare Pages başlıkları
# netlify.toml'daki kuralların birebir karşılığı. İKİSİNİ DE GÜNCEL TUT:
# netlify.toml Netlify'da, bu dosya Cloudflare Pages'te geçerlidir.
#
# CSP notu — YENİ BİR RADYO/YAYIN EKLERSEN:
#   Yeni yayın adresinin alan adını aşağıdaki media-src VE connect-src
#   listelerine eklemezsen o radyo çalmaz. (connect-src, HLS/.m3u8
#   yayınlarının parça indirmesi için de şart.)
# Site inline <script> ve <style> kullandığından 'unsafe-inline' zorunlu.
# blob: → hls.js'in MediaSource nesnesi için gerekli.
# font-src 'self' → /fontlar/ altındaki marka yazıyüzleri.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https://live.radyofenomen.com https://yayin.radyoboombox.com.tr https://yayin.istanbulfm.com.tr; connect-src 'self' https://bezwdlxombiirihxomnv.supabase.co https://live.radyofenomen.com https://yayin.radyoboombox.com.tr https://yayin.istanbulfm.com.tr; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests

# Görseller uzun süre önbellekte kalsın (hızlı açılış)
/logo/*
  Cache-Control: public, max-age=604800

/yayincilar/*
  Cache-Control: public, max-age=604800

/programlar/*
  Cache-Control: public, max-age=604800

/gorseller/*
  Cache-Control: public, max-age=604800

/og/*
  Cache-Control: public, max-age=604800

/vendor/*
  Cache-Control: public, max-age=2592000, immutable

# Marka yazıyüzleri — değişmez dosyalar
/fontlar/*
  Cache-Control: public, max-age=2592000, immutable

# HTML her zaman taze gelsin (panelden yapılan içerik değişikliği anında görünsün)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Yönetim paneli arama motorlarına kapalı
/admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=0, must-revalidate
